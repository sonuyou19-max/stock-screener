# ─────────────────────────────────────────────────────────────
# Indian Stock Screener — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains your credentials.
# ─────────────────────────────────────────────────────────────

# ── Alerts (Telegram) ────────────────────────────────────────
# Alerts go out over the Telegram Bot API, not email.
#   1. Message @BotFather on Telegram → /newbot → copy the token
#   2. Message your new bot once so it has a chat to reply in
#   3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates → copy "id"
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ── Screener Config ──────────────────────────────────────────
# Total investment budget in INR
BUDGET=100000

# ── Railway Config (set these in Railway dashboard) ──────────
# PORT is auto-set by Railway — do not change
# PORT=8000
